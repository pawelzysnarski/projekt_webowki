generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model klub {
  id             Int         @id @default(autoincrement())
  nazwa          String      @db.VarChar(100)
  miasto         String      @db.VarChar(100)
  stadion        String      @db.VarChar(255)
  herb           String      @db.VarChar(100)
  skrot          String      @db.VarChar(10)
  sila           Int         @map("Siła")
  tabela         tabela?
  meczeGospodarz terminarz[] @relation("terminarz_ID_GospodarzaToklub")
  meczeGosc      terminarz[] @relation("terminarz_ID_Go_ciaToklub")
}

model tabela {
  idKlubu      Int  @id @map("ID_Klubu")
  mecze        Int  @map("Mecze")
  zwyciestwa   Int  @map("Zwycięstwa")
  remisy       Int  @map("Remisy")
  porazki      Int  @map("Porażki")
  goleZdobyte  Int  @map("Gole_Zdobyte")
  goleStracone Int  @map("Gole_Stracone")
  bilansBramek Int  @map("Bilans_Bramek")
  punkty       Int  @map("Punkty")
  klub         klub @relation(fields: [idKlubu], references: [id], onUpdate: Restrict, map: "tabela_ibfk_1")
}

model terminarz {
  id            Int      @id @default(autoincrement()) @map("ID")
  Numer_Kolejki Int
  idGospodarza  Int      @map("ID_Gospodarza")
  idGoscia      Int      @map("ID_Gościa")
  dataSpotkania DateTime @map("Data_Spotkania") @db.DateTime(0)
  gospodarz     klub     @relation("terminarz_ID_GospodarzaToklub", fields: [idGospodarza], references: [id], onUpdate: Restrict, map: "terminarz_ibfk_1")
  gosc          klub     @relation("terminarz_ID_Go_ciaToklub", fields: [idGoscia], references: [id], onUpdate: Restrict, map: "terminarz_ibfk_2")
  wynik         wyniki?

  @@index([idGospodarza], map: "ID_Gospodarza")
  @@index([idGoscia], map: "ID_Gościa")
}

model wyniki {
  idMeczu          Int       @id @map("ID_meczu")
  bramkiGospodarzy Int       @map("Bramki_Gospodarzy")
  bramkiGosci      Int       @map("Bramki_Gości")
  terminarz        terminarz @relation(fields: [idMeczu], references: [id], onUpdate: Restrict, map: "wyniki_ibfk_1")
}

model produkty {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  price       Decimal @db.Decimal(10, 2)
  category    String  @db.VarChar(50)
  subcategory String  @db.VarChar(50)
  image       String  @db.VarChar(255)
}

model akapity {
  ID            Int        @id @default(autoincrement())
  ID_Wiadomo_ci Int        @map("ID_Wiadomości")
  Tre__         String     @map("Treść") @db.VarChar(1000)
  wiadomo_ci    wiadomo_ci @relation(fields: [ID_Wiadomo_ci], references: [ID], onUpdate: Restrict, map: "akapity_ibfk_1")

  @@index([ID_Wiadomo_ci], map: "ID_Wiadomości")
}

model dru_yna {
  ID       Int    @id @default(autoincrement())
  Imie     String @db.VarChar(40)
  Nazwisko String @db.VarChar(40)
  Pozycja  String @db.VarChar(30)
  Numer    Int
  Waga     Int
  Wzrost   Int
  Kraj     String @db.VarChar(50)
  Mecze    Int
  Bramki   Int
  Asysty   Int

  @@map("drużyna")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model personel {
  ID       Int
  Imie     String @db.VarChar(40)
  Nazwisko String @db.VarChar(40)
  Profesja String @db.VarChar(100)
  Kraj     String @db.VarChar(50)

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model u_ytkownik {
  ID    Int
  Login String @db.VarChar(255)
  Has_o String @map("Hasło") @db.VarChar(255)

  @@map("użytkownik")
  @@ignore
}

model wiadomo_ci {
  ID      Int       @id @default(autoincrement())
  Zdj_cie String    @map("Zdjęcie") @db.VarChar(100)
  akapity akapity[]

  @@map("wiadomości")
}
