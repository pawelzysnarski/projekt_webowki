generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model klub {
  id             Int         @id @default(autoincrement())
  nazwa          String      @db.VarChar(100)
  miasto         String      @db.VarChar(100)
  stadion        String      @db.VarChar(255)
  herb           String      @db.VarChar(100)
  skrot          String      @db.VarChar(10)
  sila           Int         @map("Siła")
  tabela         tabela?
  meczeGospodarz terminarz[] @relation("terminarz_ID_GospodarzaToklub")
  meczeGosc      terminarz[] @relation("terminarz_ID_Go_ciaToklub")
}

model tabela {
  idKlubu      Int  @id @map("ID_Klubu")
  mecze        Int  @map("Mecze")
  zwyciestwa   Int  @map("Zwycięstwa")
  remisy       Int  @map("Remisy")
  porazki      Int  @map("Porażki")
  goleZdobyte  Int  @map("Gole_Zdobyte")
  goleStracone Int  @map("Gole_Stracone")
  bilansBramek Int  @map("Bilans_Bramek")
  punkty       Int  @map("Punkty")
  klub         klub @relation(fields: [idKlubu], references: [id], onUpdate: Restrict, map: "tabela_ibfk_1")
}

model terminarz {
  id            Int      @id @default(autoincrement()) @map("ID")
  idGospodarza  Int      @map("ID_Gospodarza")
  idGoscia      Int      @map("ID_Gościa")
  dataSpotkania DateTime @map("Data_Spotkania") @db.DateTime(0)
  Numer_Kolejki Int
  gospodarz     klub     @relation("terminarz_ID_GospodarzaToklub", fields: [idGospodarza], references: [id], onUpdate: Restrict, map: "terminarz_ibfk_1")
  gosc          klub     @relation("terminarz_ID_Go_ciaToklub", fields: [idGoscia], references: [id], onUpdate: Restrict, map: "terminarz_ibfk_2")
  wynik         wyniki?
  mecz          mecz?

  @@index([idGospodarza], map: "ID_Gospodarza")
  @@index([idGoscia], map: "ID_Gościa")
}

model wyniki {
  idMeczu          Int       @id @map("ID_meczu")
  bramkiGospodarzy Int       @map("Bramki_Gospodarzy")
  bramkiGosci      Int       @map("Bramki_Gości")
  terminarz        terminarz @relation(fields: [idMeczu], references: [id], onUpdate: Restrict, map: "wyniki_ibfk_1")
}

model produkty {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  price       Decimal @db.Decimal(10, 2)
  category    String  @db.VarChar(50)
  subcategory String  @db.VarChar(50)
  image       String  @db.VarChar(255)
  image_front String  @db.VarChar(255)
  image_back  String? @db.VarChar(255)
}

model akapity {
  ID            Int        @id @default(autoincrement())
  ID_Wiadomo_ci Int        @map("ID_Wiadomości")
  Tre__         String     @map("Treść") @db.VarChar(1000)
  wiadomo_ci    wiadomo_ci @relation(fields: [ID_Wiadomo_ci], references: [ID], onUpdate: Restrict, map: "akapity_ibfk_1")

  @@index([ID_Wiadomo_ci], map: "ID_Wiadomości")
}

model dru_yna {
  ID             Int       @id @default(autoincrement())
  Imie           String    @db.VarChar(40)
  Nazwisko       String    @db.VarChar(40)
  Pozycja        String    @db.VarChar(30)
  Numer          Int
  Waga           Int
  Wzrost         Int
  Kraj           String    @db.VarChar(50)
  Data_Urodzenia DateTime? @db.Date
  Mecze          Int
  Bramki         Int
  Asysty         Int

  @@map("drużyna")
}

model personel {
  ID       Int    @id @default(autoincrement())
  Imie     String @db.VarChar(40)
  Nazwisko String @db.VarChar(40)
  Profesja String @db.VarChar(100)
  Kraj     String @db.VarChar(50)
}

model uzytkownik {
  id        Int      @id @default(autoincrement())
  imie      String   @db.VarChar(100)
  nazwisko  String   @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  haslo     String   @db.VarChar(255)
  data_rej  DateTime @default(now()) @db.DateTime(0)
  karnet_id Int?
  karnet    karnet?  @relation(fields: [karnet_id], references: [id], onDelete: SetNull)

  @@map("uzytkownicy")
}

model wiadomo_ci {
  ID       Int       @id @default(autoincrement())
  Nag__wek String    @map("Nagłówek") @db.VarChar(100)
  Zdj_cie  String    @map("Zdjęcie") @db.VarChar(100)
  Data     DateTime  @default(now()) @db.Date
  akapity  akapity[]

  @@map("wiadomości")
}

model mecz {
  id            Int        @id @default(autoincrement())
  przeciwnik    String     @db.VarChar(100)
  czy_domowy    Boolean
  data_meczu    DateTime   @db.DateTime(0)
  stadion       String?    @db.VarChar(255)
  miasto        String?    @db.VarChar(100)
  id_terminarza Int?       @unique
  terminarz     terminarz? @relation(fields: [id_terminarza], references: [id], onDelete: SetNull)
  miejsca       miejsce[]
  bilety        bilet[]

  @@map("mecze")
}

model miejsce {
  id         Int     @id @default(autoincrement())
  sektor     String  @db.VarChar(10)
  rzad       String  @db.VarChar(5)
  numer      Int
  czy_zajete Boolean @default(false)
  cena       Decimal @db.Decimal(10, 2)
  typ_biletu String  @db.VarChar(50)
  id_meczu   Int
  mecz       mecz    @relation(fields: [id_meczu], references: [id], onDelete: Cascade)
  bilety     bilet[]

  @@unique([id_meczu, sektor, rzad, numer])
  @@map("miejsca")
}

model bilet {
  id           Int      @id @default(autoincrement())
  id_meczu     Int
  id_miejsca   Int      @unique
  imie         String   @db.VarChar(100)
  nazwisko     String   @db.VarChar(100)
  email        String   @db.VarChar(255)
  data_zakupu  DateTime @default(now()) @db.DateTime(0)
  czy_oplacony Boolean  @default(false)
  cena         Decimal  @db.Decimal(10, 2)
  typ_biletu   String   @db.VarChar(50)
  kod_biletu   String   @unique @db.VarChar(50)

  mecz    mecz    @relation(fields: [id_meczu], references: [id], onDelete: Cascade)
  miejsce miejsce @relation(fields: [id_miejsca], references: [id], onDelete: Cascade)

  @@map("bilety")
}

model karnet {
  id           Int          @id @default(autoincrement())
  imie         String       @db.VarChar(100)
  nazwisko     String       @db.VarChar(100)
  email        String       @db.VarChar(255)
  typ_karnetu  String       @db.VarChar(50)
  data_zakupu  DateTime     @default(now()) @db.DateTime(0)
  czy_oplacony Boolean      @default(false)
  cena         Decimal      @db.Decimal(10, 2)
  sezon        String       @db.VarChar(9)
  kod_karnetu  String       @unique @db.VarChar(50)
  uzytkownik   uzytkownik[]

  @@map("karnety")
}

model punkty_scoutingowe {
  ID                     Int       @id @default(autoincrement())
  szerokosc_geograficzna Decimal?  @db.Decimal(9, 6)
  dlugosc_geograficzna   Decimal?  @db.Decimal(9, 6)
  miejsce                String?   @db.VarChar(255)
  data                   DateTime? @db.Date
  Ilosc_miejsca          Int
  zapis                  zapis[]
}

model zapis {
  ID                 Int                @id @default(autoincrement())
  ID_Punktu          Int
  Imie               String             @db.VarChar(30)
  Nazwisko           String             @db.VarChar(50)
  Wiek               Int
  Email              String             @db.VarChar(70)
  punkty_scoutingowe punkty_scoutingowe @relation(fields: [ID_Punktu], references: [ID], onUpdate: Restrict, map: "zapis_ibfk_1")

  @@index([ID_Punktu], map: "ID_Punktu")
}
